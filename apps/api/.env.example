PORT=4000
DATABASE_URL=postgresql://mado:mado@localhost:5432/mado
BETTER_AUTH_URL=http://localhost:3100
WEB_ORIGIN=http://localhost:3100
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=hello@mado.local
# SMTP_USER=
# SMTP_PASSWORD=
# Google OAuth client (Web application). Needed only when FLAG_AUTH_GOOGLE is
# on. Redirect URI:
# http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Feature flags: true or false. Each one must match the VITE_FLAG_* of the same
# name in the web app.
# FLAG_AUTH_GOOGLE=true
# FLAG_AUTH_EMAIL_PASSWORD=false
# Set only to the addresses of your trusted reverse proxies in production.
# TRUST_PROXY=loopback

# Server-only address for checking sessions during rendering.
API_ORIGIN=http://localhost:4000
# Existing site preview API uses this public address.
VITE_API_ORIGIN=http://localhost:4000

# Development runs as a guest on local data by default. Set false to test real
# login. Production always checks the real session, regardless of this setting.
VITE_DEV_AUTH_BYPASS=true

# Email and password sign-in is paused. Set true here and
# AUTH_EMAIL_PASSWORD_ENABLED=true in the API to bring it back.
# VITE_AUTH_EMAIL_PASSWORD_ENABLED=false
